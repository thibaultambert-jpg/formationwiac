// Data model — see docs/cahier-des-charges.md, section 5.
// Tables and columns are snake_case in the database; models are PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum UserRole {
  admin
  trainer
  employee
}

enum TrainingModality {
  in_person
  remote
  blended
}

enum TrainerType {
  internal
  external
}

enum SessionStatus {
  draft
  published
  full
  completed
  cancelled
}

enum ParticipantType {
  internal
  external
}

enum EnrollmentStatus {
  confirmed
  // External enrollment holding a seat until its training agreement is signed
  // (or an admin waives it with a reason).
  pending_agreement
  waitlisted
  cancelled
  present
  absent
}

// How the training is paid for (BPF breakdown, Qualiopi scope).
enum FundingType {
  none // internal training plan
  company // client company's own funds
  opco
  cpf
  france_travail
  region
  other
}

enum ConventionStatus {
  draft
  sent
  signed
  cancelled
}

enum EnrollmentSource {
  front
  back_office
}

enum EvaluationType {
  hot
  cold
}

enum SignatureMethod {
  participant_link
  trainer_device
  // Accessible alternative to the drawn signature, with the personal link.
  attestation_checkbox
}

// Attendance correction declared by the trainer or an admin (append-only).
enum AttendanceState {
  present
  absent
  late
  left_early
}

enum TokenPurpose {
  attendance
  trainer_attendance
  hot_evaluation
  cold_evaluation
}

enum QuestionAnswerType {
  scale_1_5
  scale_0_10
  single_choice
  choice_with_other
  text
}

// Every generated PDF and every email sent is traced in `documents` (section 8).
enum DocumentType {
  // PDF documents
  convocation
  convention
  attendance_sheet
  certificate
  completion_certificate
  program
  // Emails
  pre_training_information
  enrollment_confirmation
  waitlist_notice
  waitlist_promotion
  reminder
  attendance_link
  trainer_attendance_link
  evaluation_request
  evaluation_reminder
  session_cancellation
}

// ───────────── Users ─────────────

model User {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @unique
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  role        UserRole  @default(employee)
  department  String?
  active      Boolean   @default(true)
  // End of the employment relationship (retention of internal training data, E5).
  leftAt      DateTime? @map("left_at") @db.Timestamptz
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  trainer            Trainer?
  participant        Participant?
  enrollmentsCreated Enrollment[] @relation("EnrolledBy")
  auditLogs          AuditLog[]

  @@map("users")
}

// ───────────── Catalogue ─────────────

// Training themes, managed in the settings screen (catalogue filter, section 7).
model Theme {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  trainings Training[]

  @@map("themes")
}

model Training {
  id                String           @id @default(uuid(7)) @db.Uuid
  title             String
  slug              String           @unique
  themeId           String?          @map("theme_id") @db.Uuid
  objectives        String           @db.Text
  prerequisites     String?          @db.Text
  targetAudience    String?          @map("target_audience") @db.Text
  programText       String?          @map("program_text") @db.Text
  programPdfPath    String?          @map("program_pdf_path")
  durationHours     Decimal          @map("duration_hours") @db.Decimal(5, 1)
  modality          TrainingModality
  priceExclTax      Decimal?         @map("price_excl_tax") @db.Decimal(10, 2)
  thingsToBring     String?          @map("things_to_bring") @db.Text
  // Public information (Qualiopi indicators 1 and 2, prior information B3).
  accessDelay       String?          @map("access_delay") @db.Text
  teachingMethods   String?          @map("teaching_methods") @db.Text
  evaluationMethods String?          @map("evaluation_methods") @db.Text
  accessibility     String?          @db.Text
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  theme    Theme?            @relation(fields: [themeId], references: [id])
  sessions TrainingSession[]

  @@index([themeId])
  @@map("trainings")
}

model Trainer {
  id          String      @id @default(uuid(7)) @db.Uuid
  type        TrainerType
  userId      String?     @unique @map("user_id") @db.Uuid
  firstName   String      @map("first_name")
  lastName    String      @map("last_name")
  email       String
  phone       String?
  company     String?
  specialties String[]
  cvPath      String?     @map("cv_path")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user           User?              @relation(fields: [userId], references: [id])
  sessions       SessionTrainer[]
  slotSignatures TrainerSignature[]
  accessTokens   AccessToken[]

  @@map("trainers")
}

// ───────────── Sessions ─────────────

// Named TrainingSession to avoid confusion with authentication sessions.
model TrainingSession {
  id                   String        @id @default(uuid(7)) @db.Uuid
  trainingId           String        @map("training_id") @db.Uuid
  reference            String        @unique // e.g. FORM-2026-014
  status               SessionStatus @default(draft)
  location             String?
  videoLink            String?       @map("video_link")
  capacityMax          Int           @map("capacity_max")
  capacityMin          Int?          @map("capacity_min")
  registrationDeadline DateTime?     @map("registration_deadline") @db.Timestamptz
  openToInternal       Boolean       @default(true) @map("open_to_internal")
  openToExternal       Boolean       @default(false) @map("open_to_external")
  // Funded by public or pooled funds (OPCO, CPF, France Travail, Region):
  // Qualiopi obligations become blocking.
  qualiopiScope        Boolean       @default(false) @map("qualiopi_scope")
  accessInfo           String?       @map("access_info") @db.Text
  internalNotes        String?       @map("internal_notes") @db.Text
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz
  cancellationReason   String?       @map("cancellation_reason")
  // Legal hold (funder audit, litigation): blocks every retention purge (E5).
  legalHoldReason      String?       @map("legal_hold_reason")
  legalHoldAt          DateTime?     @map("legal_hold_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  training     Training         @relation(fields: [trainingId], references: [id])
  slots        SessionSlot[]
  trainers     SessionTrainer[]
  enrollments  Enrollment[]
  documents    Document[]
  accessTokens AccessToken[]
  conventions  Convention[]

  @@index([trainingId])
  @@index([status])
  @@map("sessions")
}

// A slot is a half-day (or any time range) used for attendance tracking.
model SessionSlot {
  id        String   @id @default(uuid(7)) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz

  session           TrainingSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendances       Attendance[]
  trainerSignatures TrainerSignature[]
  corrections       AttendanceCorrection[]
  accessTokens      AccessToken[]

  @@index([sessionId, startsAt])
  @@map("session_slots")
}

model SessionTrainer {
  sessionId String @map("session_id") @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainer Trainer         @relation(fields: [trainerId], references: [id])

  @@id([sessionId, trainerId])
  @@index([trainerId])
  @@map("session_trainers")
}

// ───────────── External companies and participants ─────────────

model Company {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String
  siret            String?   @unique
  addressLine      String?   @map("address_line")
  postalCode       String?   @map("postal_code")
  city             String?
  country          String    @default("France")
  mainContactId    String?   @unique @map("main_contact_id") @db.Uuid
  billingEmail     String?   @map("billing_email")
  hubspotCompanyId String?   @unique @map("hubspot_company_id")
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  mainContact       Participant?  @relation("CompanyMainContact", fields: [mainContactId], references: [id])
  participants      Participant[] @relation("CompanyParticipants")
  billedEnrollments Enrollment[]
  mergedInto        Company?      @relation("CompanyMerge", fields: [mergedIntoId], references: [id])
  mergedCompanies   Company[]     @relation("CompanyMerge")
  conventions       Convention[]

  @@index([name])
  @@map("companies")
}

model Participant {
  id               String          @id @default(uuid(7)) @db.Uuid
  type             ParticipantType
  userId           String?         @unique @map("user_id") @db.Uuid
  companyId        String?         @map("company_id") @db.Uuid
  firstName        String          @map("first_name")
  lastName         String          @map("last_name")
  email            String          @unique
  jobTitle         String?         @map("job_title")
  phone            String?
  hubspotContactId String?         @unique @map("hubspot_contact_id")
  archivedAt       DateTime?       @map("archived_at") @db.Timestamptz
  anonymizedAt     DateTime?       @map("anonymized_at") @db.Timestamptz
  legalHoldReason  String?         @map("legal_hold_reason")
  legalHoldAt      DateTime?       @map("legal_hold_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user          User?        @relation(fields: [userId], references: [id])
  company       Company?     @relation("CompanyParticipants", fields: [companyId], references: [id])
  mainContactOf Company?     @relation("CompanyMainContact")
  enrollments   Enrollment[]

  @@index([companyId])
  @@index([lastName, firstName])
  @@map("participants")
}

// ───────────── Enrollments and follow-up ─────────────

model Enrollment {
  id                    String           @id @default(uuid(7)) @db.Uuid
  sessionId             String           @map("session_id") @db.Uuid
  participantId         String           @map("participant_id") @db.Uuid
  status                EnrollmentStatus
  // Frozen at enrollment time, so that a later change of the participant does
  // not rewrite history.
  participantType       ParticipantType  @map("participant_type")
  fundingType           FundingType      @default(none) @map("funding_type")
  source                EnrollmentSource
  enrolledById          String?          @map("enrolled_by_id") @db.Uuid
  // Billing fields kept for the future invoicing tool, no logic in V1.
  appliedPrice          Decimal?         @map("applied_price") @db.Decimal(10, 2)
  billingCompanyId      String?          @map("billing_company_id") @db.Uuid
  enrolledAt            DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  motivation            String?          @db.Text
  cancelledAt           DateTime?        @map("cancelled_at") @db.Timestamptz
  cancellationReason    String?          @map("cancellation_reason")
  conventionId          String?          @map("convention_id") @db.Uuid
  // Admin waiver of the training agreement (B2), with a mandatory reason.
  agreementWaiverReason String?          @map("agreement_waiver_reason")
  agreementWaivedAt     DateTime?        @map("agreement_waived_at") @db.Timestamptz
  agreementWaivedById   String?          @map("agreement_waived_by_id") @db.Uuid
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  session        TrainingSession        @relation(fields: [sessionId], references: [id])
  participant    Participant            @relation(fields: [participantId], references: [id])
  convention     Convention?            @relation(fields: [conventionId], references: [id])
  enrolledBy     User?                  @relation("EnrolledBy", fields: [enrolledById], references: [id])
  billingCompany Company?               @relation(fields: [billingCompanyId], references: [id])
  attendances    Attendance[]
  corrections    AttendanceCorrection[]
  evaluations    Evaluation[]
  documents      Document[]
  accessTokens   AccessToken[]

  @@unique([sessionId, participantId])
  // Waitlist order: first waitlisted by enrolledAt.
  @@index([sessionId, status, enrolledAt])
  @@index([participantId])
  @@index([conventionId])
  @@map("enrollments")
}

// Training agreement (convention de formation) between the organization and a
// client company for one session. The PDF is generated by the app; the signed
// copy is uploaded. Signing confirms the linked pending enrollments.
model Convention {
  id             String           @id @default(uuid(7)) @db.Uuid
  reference      String           @unique // e.g. CONV-2026-001
  sessionId      String           @map("session_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  status         ConventionStatus @default(draft)
  priceExclTax   Decimal?         @map("price_excl_tax") @db.Decimal(10, 2)
  financialTerms String?          @map("financial_terms") @db.Text
  generatedPath  String?          @map("generated_path")
  generatedAt    DateTime?        @map("generated_at") @db.Timestamptz
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz
  signedPath     String?          @map("signed_path")
  signedAt       DateTime?        @map("signed_at") @db.Timestamptz
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  session     TrainingSession @relation(fields: [sessionId], references: [id])
  company     Company         @relation(fields: [companyId], references: [id])
  enrollments Enrollment[]

  @@index([sessionId, companyId])
  @@map("conventions")
}

// Signature of a participant for one slot. Append-only (database triggers):
// corrections go to attendance_corrections; only the retention purge may
// clear the technical data. `recordHash` is the SHA-256 fingerprint of the
// record (participant, session, slot, server timestamp, signature image).
model Attendance {
  id              String           @id @default(uuid(7)) @db.Uuid
  enrollmentId    String           @map("enrollment_id") @db.Uuid
  slotId          String           @map("slot_id") @db.Uuid
  // Legacy rows (before the audit) may be admin marks without signature.
  present         Boolean          @default(false)
  signaturePath   String?          @map("signature_path")
  signedAt        DateTime?        @map("signed_at") @db.Timestamptz
  ipAddress       String?          @map("ip_address")
  userAgent       String?          @map("user_agent")
  tokenId         String?          @map("token_id") @db.Uuid
  method          SignatureMethod?
  signatureSha256 String?          @map("signature_sha256")
  recordHash      String?          @map("record_hash")

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id])
  slot       SessionSlot @relation(fields: [slotId], references: [id])

  @@unique([enrollmentId, slotId])
  @@index([slotId])
  @@map("attendances")
}

// Append-only correction of a participant's attendance for one slot (absence,
// lateness, early departure, presence without signature), with its reason and
// author. The latest correction wins over the signature.
model AttendanceCorrection {
  id              String          @id @default(uuid(7)) @db.Uuid
  enrollmentId    String          @map("enrollment_id") @db.Uuid
  slotId          String          @map("slot_id") @db.Uuid
  state           AttendanceState
  // Arrival time (late) or departure time (left early).
  eventAt         DateTime?       @map("event_at") @db.Timestamptz
  reason          String
  authorUserId    String?         @map("author_user_id") @db.Uuid
  authorTrainerId String?         @map("author_trainer_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  recordHash      String          @map("record_hash")

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id])
  slot       SessionSlot @relation(fields: [slotId], references: [id])

  @@index([enrollmentId, slotId, createdAt])
  @@map("attendance_corrections")
}

// Trainer signature per slot, printed on the attendance sheet.
model TrainerSignature {
  id              String   @id @default(uuid(7)) @db.Uuid
  slotId          String   @map("slot_id") @db.Uuid
  trainerId       String   @map("trainer_id") @db.Uuid
  signaturePath   String   @map("signature_path")
  signedAt        DateTime @map("signed_at") @db.Timestamptz
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  tokenId         String?  @map("token_id") @db.Uuid
  signatureSha256 String?  @map("signature_sha256")
  recordHash      String?  @map("record_hash")

  slot    SessionSlot @relation(fields: [slotId], references: [id])
  trainer Trainer     @relation(fields: [trainerId], references: [id])

  @@unique([slotId, trainerId])
  @@map("trainer_signatures")
}

// Token-based links (attendance, evaluations) usable without login.
// Only a hash of the token is stored. Participant links reference an
// enrollment; trainer attendance links reference a session and a trainer.
model AccessToken {
  id           String       @id @default(uuid(7)) @db.Uuid
  purpose      TokenPurpose
  tokenHash    String       @unique @map("token_hash")
  enrollmentId String?      @map("enrollment_id") @db.Uuid
  sessionId    String?      @map("session_id") @db.Uuid
  trainerId    String?      @map("trainer_id") @db.Uuid
  // Participant attendance links are issued per slot and used once (C2).
  slotId       String?      @map("slot_id") @db.Uuid
  // Valid from (attendance links open shortly before their slot).
  validFrom    DateTime?    @map("valid_from") @db.Timestamptz
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz
  consumedAt   DateTime?    @map("consumed_at") @db.Timestamptz
  lastUsedAt   DateTime?    @map("last_used_at") @db.Timestamptz
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id])
  session    TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainer    Trainer?         @relation(fields: [trainerId], references: [id])
  slot       SessionSlot?     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, purpose])
  @@index([sessionId, trainerId])
  @@map("access_tokens")
}

model Evaluation {
  id             String         @id @default(uuid(7)) @db.Uuid
  enrollmentId   String         @map("enrollment_id") @db.Uuid
  type           EvaluationType
  // [{ questionId, label, answerType, answer }] — labels are frozen at submission
  // so later edits of the questionnaire do not alter past answers.
  answers        Json?
  globalScore    Decimal?       @map("global_score") @db.Decimal(4, 2)
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz
  reminderSentAt DateTime?      @map("reminder_sent_at") @db.Timestamptz
  submittedAt    DateTime?      @map("submitted_at") @db.Timestamptz

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([enrollmentId, type])
  @@map("evaluations")
}

// Editable questionnaire (appendix), managed in the settings screen.
model EvaluationQuestion {
  id             String             @id @default(uuid(7)) @db.Uuid
  evaluationType EvaluationType     @map("evaluation_type")
  position       Int
  label          String
  answerType     QuestionAnswerType @map("answer_type")
  options        Json? // choice labels for single_choice / choice_with_other
  required       Boolean            @default(true)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([evaluationType, position])
  @@map("evaluation_questions")
}

model Document {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           DocumentType
  sessionId      String?      @map("session_id") @db.Uuid
  enrollmentId   String?      @map("enrollment_id") @db.Uuid
  filePath       String?      @map("file_path")
  recipientEmail String?      @map("recipient_email")
  subject        String?
  generatedAt    DateTime?    @map("generated_at") @db.Timestamptz
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz
  gmailMessageId String?      @map("gmail_message_id")
  error          String?
  // SHA-256 of the stored file: frozen documents can be verified (C7, I2).
  sha256         String?      @map("sha256")
  // Versions of the documents attached to an email: [{ kind, name, sha256, version? }] (B3).
  attachments    Json?
  // Idempotency key of automatic sends (e.g. "reminder:<enrollmentId>").
  dedupKey       String?      @unique @map("dedup_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  session    TrainingSession? @relation(fields: [sessionId], references: [id])
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id])

  @@index([sessionId])
  @@index([enrollmentId])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // null for system actions (cron)
  action    String // create, update, archive, send, role_change, …
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────── Settings ─────────────

// Single row (id = 1).
model OrganizationSettings {
  id                        Int      @id @default(1)
  name                      String
  addressLine               String?  @map("address_line")
  postalCode                String?  @map("postal_code")
  city                      String?
  siret                     String?
  activityDeclarationNumber String?  @map("activity_declaration_number")
  logoPath                  String?  @map("logo_path")
  managerName               String?  @map("manager_name")
  managerTitle              String?  @map("manager_title")
  managerSignaturePath      String?  @map("manager_signature_path")
  contactEmail              String?  @map("contact_email")
  reminderDaysBefore        Int      @default(3) @map("reminder_days_before")
  coldEvaluationDays        Int      @default(60) @map("cold_evaluation_days")
  evaluationReminderDays    Int      @default(5) @map("evaluation_reminder_days")
  // Retention (E5): externals after the end of their last session; internals
  // after leaving; technical attendance data; expired links.
  dataRetentionYears        Int      @default(5) @map("data_retention_years")
  internalRetentionYears    Int      @default(5) @map("internal_retention_years")
  technicalRetentionMonths  Int      @default(12) @map("technical_retention_months")
  tokenRetentionDays        Int      @default(7) @map("token_retention_days")
  // Contacts shown in the prior information and the convocations (B3, D8).
  disabilityReferentName    String?  @map("disability_referent_name")
  disabilityReferentEmail   String?  @map("disability_referent_email")
  disabilityReferentPhone   String?  @map("disability_referent_phone")
  pedagogicalContact        String?  @map("pedagogical_contact")
  administrativeContact     String?  @map("administrative_contact")
  // Legal texts (E2, F1, F2), editable in the settings.
  dpoContact                String?  @map("dpo_contact")
  privacyNotice             String?  @map("privacy_notice") @db.Text
  privacyPolicy             String?  @map("privacy_policy") @db.Text
  legalNotice               String?  @map("legal_notice") @db.Text
  // Personal attendance links: usable from N minutes before the slot until N minutes after its end.
  attendanceMarginBefore    Int      @default(30) @map("attendance_margin_before")
  attendanceMarginAfter     Int      @default(60) @map("attendance_margin_after")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organization_settings")
}

// Internal regulations (règlement intérieur), versioned and dated (F3): a new
// upload adds a version, the latest one in force is sent with the prior
// information.
model InternalRegulation {
  id            String   @id @default(uuid(7)) @db.Uuid
  version       Int      @unique
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz
  filePath      String   @map("file_path")
  sha256        String
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("internal_regulations")
}

// One editable template per email type ({{prenom}}, {{formation}}, …).
model EmailTemplate {
  key       DocumentType @id
  subject   String
  body      String       @db.Text
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@map("email_templates")
}
