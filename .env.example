# ─── Database (Supabase PostgreSQL, EU region) ───────────────────────────────
# Pooled connection used by the app at runtime (Supabase "Transaction pooler", port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"
# Direct connection used by Prisma migrations (Supabase "Session pooler" or direct, port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─── Google sign-in (Auth.js) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only Google Workspace accounts of this domain can sign in (e.g. entreprise.fr).
ALLOWED_GOOGLE_DOMAIN=""
# This account is always given the administrator role at sign-in.
INITIAL_ADMIN_EMAIL=""
# Random secret of at least 32 characters: `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
# Public URL of the application, without trailing slash (http://localhost:3000 in development).
APP_URL="http://localhost:3000"

# ─── Gmail API (lot 3+; local outbox in development when unset) ──────────────────────────────────────────────────────
# Service account JSON key (single line) with domain-wide delegation, see README.
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Workspace address the emails are sent from (e.g. formation@entreprise.fr).
GMAIL_SENDER_ADDRESS=""
# Set to 1 to write emails to the local outbox in production mode without Gmail (e2e tests only).
ALLOW_LOCAL_OUTBOX=""

# ─── Supabase Storage (lot 2+; local disk fallback in development when unset) ─
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Private bucket holding all files (created by hand in Supabase, see README).
SUPABASE_STORAGE_BUCKET="documents"
# Set to 1 to store files in .storage/ in production mode without Supabase (e2e tests only).
ALLOW_LOCAL_STORAGE=""

# ─── Scheduled jobs (lot 4) ──────────────────────────────────────────────────
# Shared secret checked by cron routes (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# ─── Pennylane invoicing (lot 5; local files in development when unset) ──────
# API v2 token generated in Pennylane (Paramètres > Connectivité > Développeurs), scopes customers + customer_invoices.
PENNYLANE_API_TOKEN=""
# API base URL; keep the default.
PENNYLANE_API_URL="https://app.pennylane.com/api/external/v2"

# ─── Slack (weekly digest; local files in development when unset) ────────────
# Incoming webhook of the channel receiving the Monday digest of open trainings (https://hooks.slack.com/services/...).
SLACK_WEBHOOK_URL=""
